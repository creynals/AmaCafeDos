# amaCafe backend environment

# --- Server ---
PORT=7001
FRONTEND_URL=http://localhost:8080

# --- Database ---
DATABASE_URL=postgresql://localhost/db_taza_data

# --- Crypto ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_SECRET=change-me-in-production

# --- SumUp (Card widget embebido, CLP) ---
#
# Ciclo 15 — L2 coherence completa:
# La configuración SumUp vive en la tabla `settings` y se administra desde
# la UI /admin → "Configuración".
#
# Configuración en settings (post-migraciones 002 / 004):
#   Secretos AES-256-GCM:
#     - sumup_api_key
#     - sumup_merchant_code
#   Plano:
#     - sumup_app_id           (no sensible)
#     - sumup_mode             (mock | live, caché TTL 5min)
#     - sumup_return_url_base  (URL pública, caché TTL 5min)
#
# Configurar vía UI o endpoint:
#   POST /api/admin/settings/sumup  { api_key, merchant_code, app_id, mode, return_url_base }
#
# Ciclo 26 (Option A): HMAC webhook verification removida — el webhook de
# SumUp no se firma. La seguridad se delega a getCheckout + idempotencia.
#
# Los siguientes env vars se mantienen ÚNICAMENTE como fallback de bootstrap
# (por ejemplo, primer arranque pre-migración 004). Una vez aplicada 004 y
# configurado desde la UI, estos valores quedan ignorados.
SUMUP_MODE=mock
SUMUP_RETURN_URL_BASE=http://localhost:8080

# --- Email Provider (C173 SMTP + C200 Resend) ---
#
# El mailer elige provider en este orden:
#   1. MAIL_PROVIDER explícito (smtp | resend | auto)
#   2. RESEND_API_KEY presente → resend
#   3. Default → smtp
#
# Resend (HTTPS API) es preferible en Railway porque sortea el bloqueo de
# egress TCP en puertos SMTP (25/465/587). Requiere dominio verificado en
# https://resend.com/domains para que MAIL_FROM no sea rechazado (422).
#
# MAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# MAIL_FROM="amaCafe <noreply@tu-dominio-verificado.cl>"

MAIL_PROVIDER=auto
RESEND_API_KEY=

# --- SMTP (fallback / dev local) ---
#
# Cuando MAIL_ENABLED=auto (default) el envío SMTP se activa si SMTP_HOST y
# MAIL_FROM están seteados. En dev local con vars vacías, sendMail() es no-op
# silencioso. No bloquea POST /api/orders.
#
# Gmail recomendado para dev:
#   1. Activar 2FA en la cuenta Gmail
#   2. Crear App Password en https://myaccount.google.com/apppasswords
#   3. SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true
#   4. SMTP_USER=tu@gmail.com, SMTP_PASS=<app-password-de-16-chars>
#
MAIL_ENABLED=auto
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="amaCafe <ventas@amacafe.cl>"
MAIL_REPLY_TO=
